<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="BuildStore" Height="600" Width="800" Icon="/Images/icon.png" Background="{StaticResource MainBackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*"/>
            <ColumnDefinition Width="13*"/>
            <ColumnDefinition Width="51*"/>
            <ColumnDefinition Width="79*"/>
            <ColumnDefinition Width="650*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" x:Name="HeaderPanel" Visibility="Collapsed" Grid.ColumnSpan="5" Background="{StaticResource SecondaryBackgroundBrush}">
            <TextBlock x:Name="tbHeader" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,10,10,10" FontSize="20" FontWeight="Bold"/>
            <StackPanel Orientation="Vertical" Margin="0,3,10,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                <TextBlock x:Name="tbName" Text="PDSPAD" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,70,0" FontSize="14" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Выйти" Margin="0,10,10,10" Click="ButtonExit_Click" Height="25" Width="50" Background="{StaticResource MainBackgroundBrush}" FontSize="14" FontWeight="Bold"/>
                    <Button Content="Назад" x:Name="btnBack" Visibility="Collapsed" Height="25" Width="50" Background="{StaticResource MainBackgroundBrush}" FontSize="14" FontWeight="Bold" Click="ButtonBack_Click"/>
                </StackPanel>
            </StackPanel>
            <Image HorizontalAlignment="Left" Height="60" Margin="10,5,0,0" Grid.Row="2" VerticalAlignment="Top" Width="64" Source="/Images/icon.png"/>
        </Grid>
        <Frame Grid.Row="1" x:Name="MainFrame" NavigationUIVisibility="Hidden" Grid.ColumnSpan="5" Navigated="MainFrame_Navigated" />
    </Grid>
</Window>
